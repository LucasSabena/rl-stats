{
  "name": "rl-stats-landing",
  "private": true,
  "version": "2.16.4",
  "type": "module",
  "description": "Marketing landing page for RL Stats — local-first Rocket League companion",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "tsc --noEmit && node scripts/generate-seo.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "assets:capture": "bash scripts/run-capture.sh",
    "assets:overlays": "node scripts/capture-overlays.mjs",
    "assets:demos": "node scripts/record-demos.ts",
    "assets:demos:process": "node scripts/process-demos.ts",
    "assets:seo": "node scripts/generate-og.mjs && node scripts/generate-seo.mjs",
    "assets:process": "node scripts/process-assets.mjs",
    "assets:review": "node scripts/review-landing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
